{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/python_hook_bootstrap.sh",
              "SessionStart",
              "${QODER_PLUGIN_ROOT}/hosts/qoder/hook_entry.py"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/python_hook_bootstrap.sh",
              "SessionEnd",
              "${QODER_PLUGIN_ROOT}/hosts/qoder/hook_entry.py"
            ],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
