            "command": "sh \"${PLUGIN_ROOT}/scripts/python_hook_bootstrap.sh\" SessionEnd \"${PLUGIN_ROOT}/hosts/codex/hook_entry.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
