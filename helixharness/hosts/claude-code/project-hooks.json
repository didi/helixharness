{
  "project_hooks_version": "1.0",
  "owner": "bootstrap",
  "settings_file": ".claude/settings.json",
  "merge_strategy": "json_append_dedup",
  "dedupe_key": "hooks.PostToolUse[].matcher=Write|Edit|MultiEdit",
  "payload": {
    "hooks": {
      "PostToolUse": [
        {
          "matcher": "Write|Edit|MultiEdit",
          "hooks": [
            {
              "type": "command",
              "command": "\"{python}\" -X utf8 \"{plugin_root}/scripts/project_linter.py\" --repo-root \"{repo_root}\" --linter invariant-check"
            },
            {
              "type": "command",
              "command": "\"{python}\" -X utf8 \"{plugin_root}/scripts/project_linter.py\" --repo-root \"{repo_root}\" --linter spec-sync-check"
            }
          ]
        }
      ]
    }
  }
}
