# Keep executable scripts and hashed protocol resources byte-identical on checkout.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.tpl text eol=lf
*.md text eol=lf
*.json text eol=lf
*.cjs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.db binary
/output export-ignore
/.pytest_cache export-ignore
/.ruff_cache export-ignore
/.github export-ignore
