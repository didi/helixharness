# HelixHarness Platform: synthetic configuration template only.
# The service reads process environment variables; it does not auto-load this file.
# Set credentials through your process environment or secret manager.

# Observability: comma-separated application repositories, or demo.
HELIXHARNESS_PLATFORM_USAGE_DATA_SOURCE=demo
HELIXHARNESS_PLATFORM_HELIXHARNESS_ROOTS=
HELIXHARNESS_PLATFORM_USAGE_SYNC_CONFIG=
HELIXHARNESS_PLATFORM_USAGE_SYNC_CACHE=
HELIXHARNESS_PLATFORM_USAGE_AI_ENABLED=false
HELIXHARNESS_PLATFORM_USAGE_AI_BASE_URL=
HELIXHARNESS_PLATFORM_USAGE_AI_API_KEY=
HELIXHARNESS_PLATFORM_USAGE_AI_MODEL=

# Framework evaluation: source checkout, Git ref and business repository mappings.
HELIXHARNESS_PLATFORM_FRAMEWORK_EVAL_HELIXHARNESS_REPOSITORY=
HELIXHARNESS_PLATFORM_FRAMEWORK_EVAL_REFERENCE_REF=
HELIXHARNESS_PLATFORM_FRAMEWORK_EVAL_REPOSITORIES=
HELIXHARNESS_PLATFORM_FRAMEWORK_EVAL_CONFIG_PATH=
HELIXHARNESS_PLATFORM_FRAMEWORK_EVAL_CASE_SOURCE_ROOT=
HELIXHARNESS_PLATFORM_FRAMEWORK_EVAL_WORK_ROOT=
HELIXHARNESS_PLATFORM_FRAMEWORK_EVAL_MAX_CONCURRENCY=2
HELIXHARNESS_PLATFORM_EVALUATION_CODEX_BASE_URL=
HELIXHARNESS_PLATFORM_EVALUATION_CODEX_API_KEY=
HELIXHARNESS_PLATFORM_EVALUATION_CODEX_MODEL=
HELIXHARNESS_PLATFORM_EVALUATION_CLAUDE_BASE_URL=
HELIXHARNESS_PLATFORM_EVALUATION_CLAUDE_API_KEY=
HELIXHARNESS_PLATFORM_EVALUATION_CLAUDE_MODEL=
HELIXHARNESS_PLATFORM_EVALUATION_SUBAGENT_REVIEWER_API_KEY=
HELIXHARNESS_PLATFORM_EVALUATION_TUTORIAL_VIDEO_PATH=

# Optional independent runtime storage paths; use absolute paths.
HELIXHARNESS_PLATFORM_FRAMEWORK_EVAL_DB_PATH=
HELIXHARNESS_PLATFORM_TELEMETRY_DB_PATH=
HELIXHARNESS_PLATFORM_STAGE_SUPPLEMENT_DB_PATH=
HELIXHARNESS_PLATFORM_FEEDBACK_DB_PATH=
HELIXHARNESS_PLATFORM_USAGE_FIRST_SEEN_DB_PATH=
HELIXHARNESS_PLATFORM_FEATURE_EXCLUSION_DB_PATH=
HELIXHARNESS_PLATFORM_EVOLUTION_DB_PATH=
HELIXHARNESS_PLATFORM_WORKER_PROCESS_REGISTRY=

# Evolution is disabled until the operator configures evidence and capabilities.
HELIXHARNESS_PLATFORM_EVOLUTION_SCHEDULER_ENABLED=false
HELIXHARNESS_PLATFORM_EVOLUTION_SEMANTIC_ANALYZER_ENABLED=false
HELIXHARNESS_PLATFORM_EVOLUTION_CATALOG_PATH=
HELIXHARNESS_PLATFORM_EVOLUTION_RUNTIME_CONFIG_PATH=
HELIXHARNESS_PLATFORM_EVOLUTION_WORKTREE_ROOT=
HELIXHARNESS_PLATFORM_EVOLUTION_EXECUTION_USER=

# Optional public case-creator distribution configuration.
HELIXHARNESS_PLATFORM_CASE_CREATOR_GIT_URL=
HELIXHARNESS_PLATFORM_CASE_CREATOR_GIT_REF=
HELIXHARNESS_PLATFORM_CASE_CREATOR_CODEX_INSTALL_URL=
HELIXHARNESS_PLATFORM_CASE_CREATOR_PLUGIN_ROOT=
